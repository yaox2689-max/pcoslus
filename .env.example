# PCOS Environment Variables
# Copy this file to .env and fill in your values

# ============================================================
# LLM Provider Configuration
# Choose one: deepseek | kimi | qwen | mimo
# ============================================================
LLM_PROVIDER=kimi

# ============================================================
# DeepSeek API
# Get your key: https://platform.deepseek.com/
# ============================================================
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ============================================================
# Kimi (Moonshot) API
# Get your key: https://platform.moonshot.cn/
# ============================================================
KIMI_API_KEY=sk-your-kimi-key-here
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

# ============================================================
# Qwen (DashScope) API
# Get your key: https://dashscope.console.aliyun.com/
# ============================================================
QWEN_API_KEY=sk-your-qwen-key-here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# ============================================================
# MIMO API
# Get your key: https://api.mimo.ai/
# ============================================================
MIMO_API_KEY=sk-your-mimo-key-here
MIMO_BASE_URL=https://api.mimo.ai/v1
MIMO_MODEL=mimo-chat

# ============================================================
# Optional: Application Configuration
# ============================================================
# APP_ENV=development
# LOG_LEVEL=INFO
# DATABASE_URL=sqlite:///./pcos.db
